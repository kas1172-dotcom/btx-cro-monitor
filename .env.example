# BTX Engine - environment template. Copy to `.env` and fill in.
# NEVER commit real values. All platform settings use the BTX_ prefix.

# --- Integration platform (Engine #1) ---
BTX_ENV=dev
BTX_DEPLOYMENT_MODE=development
BTX_TENANT_ID=local
BTX_SOURCE_TYPE=repository_seed
BTX_DATA_PROVENANCE=Repository-backed local data
BTX_DEPLOYED_REVISION=unknown
BTX_EXPECTED_REPOSITORY_REVISION=779198f
BTX_EXTERNAL_WRITES_ENABLED=false
# Local default is SQLite; for Postgres use the compose service:
#   BTX_DATABASE_URL=postgresql+psycopg://btx:btx@localhost:5432/btx
BTX_DATABASE_URL=sqlite:///./btx_platform.db
BTX_REDIS_URL=redis://localhost:6379/0
BTX_MAX_ATTEMPTS=5
BTX_MAX_BODY_BYTES=1048576
BTX_FRONTEND_ORIGIN=http://localhost:5173
BTX_FRONTEND_ORIGINS=http://localhost:5173
BTX_ANTHROPIC_API_KEY=
BTX_ASK_ONLINE_ENABLED=false
BTX_ASK_WEB_SEARCH_ENABLED=false
BTX_ASK_DEFAULT_SOURCE_MODE=automatic
BTX_ASK_MODEL=claude-haiku-4-5-20251001
BTX_ASK_WEB_MAX_USES=3
BTX_ASK_MAX_TOOL_TURNS=2
BTX_ASK_TIMEOUT_MS=60000
BTX_ASK_MAX_OUTPUT_TOKENS=2048
BTX_ASK_DAILY_SEARCH_BUDGET=100
BTX_HUBSPOT_ACCESS_TOKEN=
BTX_GMAIL_ALLOWLIST=
BTX_LLM_TIMEOUT_SECONDS=45
BTX_LLM_MAX_BODY_BYTES=524288
BTX_PIPELINE_MECHANISM=subprocess
BTX_PIPELINE_OUTPUT_DIR=clients/btx/artifacts
BTX_PIPELINE_GENERATED_DIR=.btx_platform/generated
BTX_PIPELINE_TIMEOUT_SECONDS=900
BTX_PIPELINE_MIN_INTERVAL_SECONDS=600
BTX_GITHUB_PAT=
BTX_GITHUB_REPO=kas1172-dotcom/btx-cro-monitor
BTX_GITHUB_WORKFLOW=monitor.yml
BTX_GITHUB_REF=main

# --- Auth (WP10-A): Clerk validates every request; there is no shared token ---
# CLERK_SECRET_KEY is the backend secret key from your Clerk instance (not the
# publishable key - that one is VITE_CLERK_PUBLISHABLE_KEY, below).
CLERK_SECRET_KEY=
# Issuer URL for your Clerk instance, e.g. https://your-app.clerk.accounts.dev
BTX_CLERK_ISSUER=
# Optional: only set if you configured a specific JWT audience in Clerk.
BTX_CLERK_AUDIENCE=
BTX_RATE_LIMIT_MAX_REQUESTS=30
BTX_RATE_LIMIT_WINDOW_SECONDS=60

# --- Persistence, jobs, crypto (WP10-B) ---
# memory = in-process, dev/test default; celery = real Redis-backed queue for
# the forward worker (`celery -A btx_platform.workers.celery_app worker`).
BTX_QUEUE_BACKEND=memory
# Encrypts Connection.signing_secret (and any future stored integration
# token) at rest. Required before BTX_QUEUE_BACKEND=celery / prod. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BTX_ENCRYPTION_KEY=

# Per-connection webhook signing secrets live in the `connections` table,
# encrypted at rest via BTX_ENCRYPTION_KEY - not here.

# --- Insights / newsletter engine (Engine #2, existing monitor_engine) ---
ANTHROPIC_API_KEY=
# Email delivery (Phase 6):
# RESEND_API_KEY=

# --- Frontend ---
# The cockpit has one runtime data path: authenticated backend WorldSnapshot.
VITE_BACKEND_ENDPOINT=http://localhost:8000
VITE_COPILOT_ENDPOINT=
# Clerk publishable key - safe for the browser (it identifies the Clerk
# instance, not a secret). The matching CLERK_SECRET_KEY above stays server-side.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_DEPLOYMENT_MODE=development
VITE_TENANT_ID=local
VITE_SOURCE_TYPE=repository_seed
VITE_DATA_PROVENANCE=Repository-backed local data
VITE_DEPLOYED_REVISION=unknown
# Integration environment must be explicit: sandbox, developer, production, or none.
BTX_HUBSPOT_ENVIRONMENT=none
# Default-safe production portal override. Leave false unless using a disposable
# or explicitly approved production-class HubSpot tenant for write verification.
BTX_HUBSPOT_ALLOW_PRODUCTION_WRITES=false

# --- Optional integration seams (all production-safe defaults are OFF) ---
# Credential formats, vendor endpoints, and exact scope strings remain
# BLOCKED-ON-SPEC. Store AUTH_SECRET values only in Fly.io/GitHub Actions secrets.
BTX_CONTACT_REGISTRY_ENABLED=false
BTX_CONTACT_REGISTRY_BASE_URL=
BTX_CONTACT_REGISTRY_AUTH_SECRET=
BTX_CONTACT_REGISTRY_AUTH_SCOPES=
BTX_CONTACT_REGISTRY_TIMEOUT_SECONDS=10

BTX_PRISM_ENABLED=false
BTX_PRISM_BASE_URL=
BTX_PRISM_AUTH_SECRET=
BTX_PRISM_AUTH_SCOPES=
BTX_PRISM_TIMEOUT_SECONDS=10

BTX_PAPERLESS_PARTS_ENABLED=false
BTX_PAPERLESS_PARTS_BASE_URL=
BTX_PAPERLESS_PARTS_AUTH_SECRET=
BTX_PAPERLESS_PARTS_AUTH_SCOPES=
BTX_PAPERLESS_PARTS_TIMEOUT_SECONDS=10

BTX_ERP_MES_ENABLED=false
BTX_ERP_MES_BASE_URL=
BTX_ERP_MES_AUTH_SECRET=
BTX_ERP_MES_AUTH_SCOPES=
BTX_ERP_MES_TIMEOUT_SECONDS=10
